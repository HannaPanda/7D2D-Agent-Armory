<?xml version="1.0" encoding="UTF-8" ?>
<configs>

	<!-- ============================================================
	     CLUSTER POD  – the object spawned where the grenade lands.
	     Inert while arming, then bursts into child seekers (C# MinEventAction).
	     Model/physics reused from a small ground animal (placeholder art).
	     ============================================================ -->
	<append xpath="/entity_classes">
		<entity_class name="entitySeekerCluster" extends="animalRabbit">
			<property name="Tags" value="entity,seeker,seekerPod"/>
			<property name="Faction" value="animals"/>
			<property name="Mass" value="30"/>
			<property name="HealthMax" value="20"/>
			<property name="ExperienceGain" value="0"/>

			<!-- ===== Custom art: sci-fi drone AssetBundle (replaces rabbit mesh) =====
			     ModelType=Standard (NOT Drone!): the rabbit is EntityAnimalRabbit, a GROUND
			     entity whose movement needs m_characterController, which is created from
			     PhysicsBody="rabbit" (inherited) ONLY on the Standard model path. EModelDrone
			     is built for Class=EntityDrone (hover physics, no PhysicsBody/CharacterController)
			     and left m_characterController null -> EntityMoveHelper.UpdateMoveHelper NRE-flood.
			     AvatarControllerDummy = no animation logic (our mesh is boneless; we spin it in
			     C#). Prefab points into our bundle Resources/seekerdrone.unity3d, prefab "SeekerDrone".
			     Pod is scaled a bit bigger than the children. -->
			<property name="ModelType" value="Standard"/>
			<property name="AvatarController" value="AvatarControllerDummy"/>
			<property name="Prefab" value="#@modfolder:Resources/seekerdrone.unity3d?SeekerDrone.prefab"/>
			<property name="PrefabCombined" value="true"/>
			<!-- SizeScale MUSS >= 1 sein. IL `Entity.SetCCScale(scale)`:
			       center = GetCenter() * scale;   height = GetHeight() * scale;
			       radius = GetRadius() * Utils.FastMax(scale, 1f);
			     Center und Hoehe skalieren mit, der RADIUS wird durch FastMax nach unten auf
			     Faktor 1 gepinnt. Jedes scale < 1 macht den Radius also relativ zur Hoehe um
			     1/scale zu gross; danach klemmt KinematicCharacterMotor.ValidateData die Hoehe
			     auf radius*2 hoch und die Kapsel entartet zur Kugel (die Hemisphaerenmittelpunkte
			     fallen zusammen -> ProbeGround/Sweeps liefern nichts). Genau das war die Ursache
			     fuer Durchfallen, Kreisen, Wandklettern und Bouncen.
			     Basis ist jetzt das KIND mit 1.0; der Pod ist das Groessenverhaeltnis
			     0.20 / 0.11 = 1.818 - ueber 1, dort ist FastMax ein No-Op und Radius, Hoehe und
			     Center skalieren konsistent (r=0.309 h=0.727 cY=0.364). -->
			<property name="SizeScale" value="1.818"/>
			<!-- The rabbit inherits skeletal flags that break a boneless mesh; disable them. -->
			<property name="HasDeathAnim" value="false"/>
			<property name="RootMotion" value="false"/>
			<property name="HasRagdoll" value="false"/>
			<!-- LookAtAngle>0 makes EModelBase try head-look aiming, which NREs on a boneless
			     mesh (no gaze controller / neck bones). 0 disables it entirely. -->
			<property name="LookAtAngle" value="0"/>
			<!-- Pod MOVES: er folgt dem Spieler. Bewusst LANGSAMER als die Kinder.
			     2.7 war Zombie-Hoechstgeschwindigkeit (schnellster vanilla Feral: "2.1, 2.3")
			     und wirkte als Begleiter hektisch: der Pod schoss mit Vollgas zum Spieler.
			     Die Kinder BRAUCHEN 2.7, weil sie fliehende Ziele einholen und rammen muessen;
			     der Pod muss nur mithalten. 2.2 liegt knapp unter dem schnellsten Zombie.
			     "min, max" ist Pflicht: GetMoveSpeedAggro liest zwei getrennte Felder
			     (min bei Tag, max nachts/Blutmond), ein Einzelwert laesst das andere ~0. -->
			<!-- TEMPO - BITTE VOR DEM AENDERN LESEN.
			     Diese Werte sind nur deshalb wirksam, weil `Patch_SeekerStepLimiter` den Weg pro
			     Tick auf `MoveSpeedAggro / 20 * Tolerance(1.5)` deckelt. Ohne ihn laeuft die
			     Geschwindigkeit voellig frei (gemessen: 22 m/s bei eingestellten 2.2), weil bei
			     `RootMotion=false` weder MoveSpeed noch MoveSpeedAggro in die Fortbewegung eingehen.
			     OBERGRENZE ist das Verhaeltnis Schritt/Kapselradius. Wird es zu gross, springt die
			     Drohne ueber duenne Geometrie, bevor die Kollision aufgeloest werden kann.
			     Referenz: 1.19x lief nachweislich ohne Tunneln (Log `..._14-36-05`).
			     Pod r=0.436 (Prefab 0.24 * SizeScale 1.818):
			       6.5 m/s = 0.488/Tick = 1.12x  <- hier, unter der Referenz
			     Der Pod muss schneller sein als die Kinder, weil er dem laufenden Spieler folgt.
			     Sein Kapselradius ist an das Kind gekoppelt (ein gemeinsames Prefab), und der
			     Durchmesser von 0.87 m ist die eigentliche Grenze: darueber passt er nicht mehr
			     durch eine 1 m breite Tuer. -->
			<property name="MoveSpeed" value="6.5"/>
			<property name="MoveSpeedAggro" value="6.5, 6.5"/>
			<property name="RoamTimeMax" value="0"/>

			<!-- Custom pod brain: follow the player (class=EntityPlayer) and only arm when a
			     zombie enters detect_range; arming buff bursts into children + removes the pod.
			     chaseTimeMax 600 = follow the player persistently. -->
			<property name="AITask-1" value="SeekerPod,AgentArmory"
			          data="class=EntityPlayer,600;detect_range=12;arm_buff=buffSeekerClusterArm"/>
			<!-- KEIN Wander fuer den Pod: er soll dem Spieler folgen, nicht umherstreifen.
			     EAIWander (MutexBits=1) ist ausserdem inkompatibel mit unserem SeekerPod
			     (via EAIApproachAndAttackTarget, MutexBits=3): solange Wander laeuft,
			     blockiert EAITaskList.isBestTask den Follow-Task komplett.
			     AITask-4 muss ebenfalls gesetzt werden, weil animalRabbit dort Wander definiert
			     und es sonst geerbt aktiv bliebe. Loeschen per value="" wirft, daher Look. -->
			<property name="AITask-2" value="Look"/>
			<property name="AITask-3" value="Look"/>
			<property name="AITask-4" value="Look"/>

			<!-- Keine Leiche (siehe Kommentar beim Child): Pod zaehlt als Tier und koennte
			     sonst als Kadaver von Zombies gefressen werden. -->
			<property name="TimeStayAfterDeath" value="0"/>

			<!-- Immune to explosions too, so a child's blast can't corpse the pod. -->
			<effect_group>
				<passive_effect name="ExplosionIncomingDamage" operation="perc_add" value="-1.0"/>
			</effect_group>
		</entity_class>

		<!-- ============================================================
		     CHILD SEEKER – autonomous hunter. Acquires nearest enemy by
		     CLASS (works regardless of faction), chases, and detonates on
		     contact via the custom EAISeekerDetonate task.
		     ============================================================ -->
		<entity_class name="entitySeekerChild" extends="animalRabbit">
			<property name="Tags" value="entity,seeker,seekerChild"/>
			<property name="Faction" value="animals"/>
			<property name="Mass" value="18"/>
			<property name="HealthMax" value="10"/>
			<property name="ExperienceGain" value="0"/>

			<!-- ===== Custom art: same drone bundle as the pod, scaled smaller. =====
			     ModelType=Standard for the same reason as the pod (ground CharacterController
			     from PhysicsBody; EModelDrone would null it and NRE-flood). -->
			<property name="ModelType" value="Standard"/>
			<property name="AvatarController" value="AvatarControllerDummy"/>
			<property name="Prefab" value="#@modfolder:Resources/seekerdrone.unity3d?SeekerDrone.prefab"/>
			<property name="PrefabCombined" value="true"/>
			<!-- Basisgroesse: 1.0 (Begruendung zu FastMax siehe beim Pod oben). Die Prefab-
			     Kapsel ist damit direkt der Weltwert: r=0.17 h=0.40 cY=0.20.
			     Die sichtbare Groesse bleibt unveraendert, weil der Mesh-Node im Prefab den
			     wegfallenden 0.11-Faktor uebernimmt (0.01 -> 0.0011; netto weiterhin 0.0011
			     beim Kind und 0.0011*1.818 = 0.0020 beim Pod). -->
			<property name="SizeScale" value="1.0"/>
			<!-- Same skeletal-flag disables as the pod (boneless mesh). -->
			<property name="HasDeathAnim" value="false"/>
			<property name="RootMotion" value="false"/>
			<property name="HasRagdoll" value="false"/>
			<property name="LookAtAngle" value="0"/>
			<!-- MoveSpeedAggro MUST be "min, max" (min used in daylight, max at night/BM;
			     GetMoveSpeedAggro reads two separate fields). A single value leaves the
			     other field near 0 -> snail pace. 2.3 matches the FASTEST vanilla zombie
			     (feral runners cap at "2.1, 2.3"), so seekers keep pace with anything. -->
			<!-- TEMPO - Begruendung und Grenzwert siehe Pod oben.
			     Die Kinder muessen den schnellsten Zombie EINHOLEN, sonst haengen sie hinterher,
			     laufen in ihre lifetime und verschwinden ungenutzt (beobachtet im Test vom
			     2026-07-25). Deshalb bewusst ueber vanilla-Zombietempo.
			     Kind r=0.240 (Prefab-Kapsel, durch h/2 = 0.275 nach oben begrenzt):
			       2.7 m/s = 0.203/Tick = 1.19x  <- die erprobte Referenz (damals r=0.170)
			       4.0 m/s = 0.300/Tick = 1.25x  <- hier, minimal darueber
			     Der Sprung von 2.7 auf 4.0 kommt NICHT aus einem hoeheren Risiko, sondern aus dem
			     groesseren Collider (Prefab-Kapsel 0.17/0.40 -> 0.24/0.55). Wer hier weiter
			     hochdreht, ohne den Collider mitzuziehen, holt sich das Wandtunneln zurueck.
			     Weitere Vergroesserung ist durch den POD gedeckelt: er skaliert mit 1.818 mit und
			     passt ab etwa r=0.25 nicht mehr durch eine 1 m breite Tuer. Ab da braeuchten Pod
			     und Kind getrennte Prefabs. -->
			<property name="MoveSpeed" value="4.0"/>
			<property name="MoveSpeedAggro" value="4.0, 4.0"/>
			<property name="RoamTimeMax" value="0"/>

			<!-- Custom task: acquires nearest enemy itself (C#), chases, detonates on contact.
			     class=<Name>,<chaseTimeMax> pairs: chaseTimeMax MUST be > 0 (0 = give up
			     instantly if the entity ever has a home). acquire_range = how far the task's
			     own scan looks for EntityEnemy (bypasses the player-centric animal senses). -->
			<!-- lifetime 10 -> 18 (2026-07-25): Mit 10s verschwanden Kinder mitten in der
			     Verfolgung, wenn das Ziel ein schneller Zombie war - im Test zweimal beobachtet.
			     Die Kinder sind jetzt zwar schneller (4.0), aber die Aufholjagd ueber die
			     acquire_range von 15 m braucht bei einem fliehenden Ziel schlicht laenger als 10s.
			     18s bleibt deutlich unter der Notbremse `HardLifetimeSeconds` (30s) in
			     Patch_SeekerPhysics - wer hier ueber 30 geht, muss die dort mit anheben, sonst
			     raeumt die Notbremse die Kinder vorher weg. -->
			<property name="AITask-1" value="SeekerDetonate,AgentArmory"
			          data="class=EntityEnemy,60,EntityZombie,60;detonate_dist=2.8;acquire_range=15;leash_range=24;lifetime=18;arm_buff=buffSeekerChildArm;detonate_buff=buffSeekerDetonate"/>
			<!-- Wander REMOVED: with no valid target (all sleeping/unreachable/dead) the inherited
			     Wander task made seekers roam randomly, which read as "running around randomly".
			     Now a targetless seeker just holds position until its lifetime removes it. -->
			<property name="AITask-2" value="Look"/>
			<!-- AITask-3 und -4 MUESSEN hier ueberschrieben werden. animalRabbit definiert VIER
			     AI-Tasks (RunawayWhenHurt / RunawayFromEntity / Look / Wander); wir ersetzen oben
			     nur -1 und -2, also blieben -3 (Look, harmlos) und -4 (WANDER) geerbt aktiv.
			     Wander war die Ursache fuer zwei Symptome:
			       (a) Seeker rollten ziellos umher, statt still zu halten;
			       (b) Seeker ueberlebten ihre lifetime. EAIWander hat MutexBits=1, unser
			           SeekerDetonate (via EAIApproachAndAttackTarget) MutexBits=3 -> die beiden
			           sind inkompatibel. Solange Wander ausgefuehrt wird, liefert
			           EAITaskList.isBestTask fuer unseren Task false, CanExecute() wird nie
			           aufgerufen, und genau dort sitzt der Lifetime-Check.
			     Loeschen per value="" wirft ("Class '' not found!"), deshalb mit dem harmlosen
			     Look ueberschreiben (EAILook setzt keine MutexBits, ist also mit allem vertraeglich). -->
			<property name="AITask-3" value="Look"/>
			<property name="AITask-4" value="Look"/>

			<!-- Keine Leiche: der Seeker erbt vom Tier-Template TimeStayAfterDeath=300. Wird er
			     von einem Zombie erschlagen (er zaehlt als Tier/Beute), bleibt ein Kadaver liegen
			     und Zombies FRESSEN Leichen: EAIApproachAndAttackTarget.Start setzt
			     isTargetToEat = entityTarget.IsDead(). Genau das war das beobachtete
			     "Zombie frisst Drohne". 0 = Koerper verschwindet sofort. -->
			<property name="TimeStayAfterDeath" value="0"/>

			<!-- AITarget-1 REMOVED (2026-07-23): this vanilla targeting task ran IN PARALLEL with
			     EAISeekerDetonate's own self-acquisition and fought it. EAITarget.check() revalidates
			     its target every tick via isWithinHomeDistance()/CanSee() and calls
			     theEntity.SetAttackTarget(null,0) unconditionally whenever either fails (both fail
			     constantly for a target picked by broad-phase scan outside the animal's own sense
			     range); verified via IL dump. This nulled the attack target almost every tick,
			     which our Update() sees as tgt==null -> moveHelper.Stop(), producing the stop/go
			     stutter that read as "seekers sometimes ultra slow". Log evidence: 601x "found NO
			     valid target" + the same target id repeatedly re-logged with changing distance
			     (proof of thrash) in one play session. EAISeekerDetonate.CanExecute()->AcquireTarget()
			     already does self-acquisition (world.GetEntitiesInBounds<EntityEnemy>, sticky+spread+
			     leash+unreachable-blacklist) without needing this vanilla task at all; just delete it.
			-->

			<!-- Full immunity to explosion damage: -100% incoming. Stops the cluster from
			     splash-killing itself. Each seeker instead removes ITSELF in C# a beat after
			     its blast (MarkToUnload -> no corpse); the detonation buff no longer zeroes
			     health, so no dead-rabbit body is left behind. -->
			<effect_group>
				<passive_effect name="ExplosionIncomingDamage" operation="perc_add" value="-1.0"/>
			</effect_group>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Gun. Erstes Modul der Turret-Familie.
		     ============================================================
		     `extends="junkTurretGun"` ist hier keine Bequemlichkeit, sondern die einzige
		     billige Loesung: `EntityTurret` erwartet im Prefab einen Knoten "Muzzle" sowie
		     die MonoBehaviours `AutoTurretYawLerp`, `AutoTurretPitchLerp`, Laser und Cone
		     (`MiniTurretFireController.Init`, `EntityTurret.InitTurret`). Ein eigenes FBX
		     muesste die alle nachbauen. Das vanilla junkTurret-Prefab bringt sie mit, und
		     die optische Unterscheidung der Turretsorten kostet uns trotzdem nichts:
		     `EntityTurret.OnUpdateEntity` liest `TintColor` aus dem KERN-ITEM
		     (IL_00d2..IL_0159, ueber `Block.PropTintColor` -> `UpdateLight.SetTintColorForItem`).
		     Fuenf Farben, ein Modell, null Art-Assets.

		     ⚠ `agentTurret` im Tags-Attribut ist FUNKTIONAL, nicht dekorativ. Daran erkennen
		     `Patch_TurretRuntime` und `Patch_TurretNoPickup` unsere Turrets - beide Patches
		     laufen ueber JEDES EntityTurret im Spiel, auch die von vanilla und von anderen
		     Mods. Faellt der Tag weg, verhaelt sich unser Turret wie ein Junk Turret:
		     aufsammelbar, ohne Lebenszeit, und vom Aktivzaehler abgeschaltet.

		     ⚠ MaxOwnerDistance steht bewusst NICHT hier. Vanilla setzt es an junkTurretGun,
		     aber die Zeichenkette "MaxOwnerDistance" kommt in ganz Assembly-CSharp in keiner
		     einzigen Instruktion vor (Cecil-Suche ueber alle Operanden) - das Feld
		     `EntityTurret.maxOwnerDistance` wird ausschliesslich aus dem passive_effect
		     `JunkTurretActiveRange` gefuellt (IL_0260..IL_028c, Default 10). Die Leine sitzt
		     deshalb am Kern-Item, nicht hier. Wer sie hier einstellt, aendert nichts. -->
		<entity_class name="agentTurretGun" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>

			<!-- Weiter als vanilla (15), aber unter der Leine von 35 m am Kern-Item: die
			     Reichweite soll das Turret begrenzen, nicht der Abstand zum Werfer.
			     Dieser Wert ist die BASIS fuer `MaxRange` (PassiveEffects 11) - die
			     9mm-Munition setzt selbst keinen MaxRange-Effekt, anders als die
			     Junk-Turret-Munition, also bleibt er hier stehen. -->
			<property name="MaxDistance" value="20"/>
			<!-- 170 statt 90: ein geworfenes Turret kann sich seine Ausrichtung nicht
			     aussuchen, es landet wie es landet. Ein enger Schwenkbereich waere reines
			     Wurfglueck. 170 ist der Wert des Junk Sledge und respektiert die vanilla-
			     Warnung "Keep under 180". -->
			<!-- ⚠ 360 IST NICHT "gross", SONDERN "unbeschraenkt" - UND DER WERT WIRD HALBIERT.
			     `MiniTurretFireController.Init` rechnet `wert * 0.5` und setzt daraus
			     `yawRange = (-x, +x)` (IL_0197..IL_01b5). 360 ergibt also (-180, +180), und
			     weil `Mathf.DeltaAngle` per Definition nur -180..180 liefert, besteht damit
			     JEDES Ziel die Bereichspruefung: volle Rundumsicht.
			     Vanilla schreibt an dieser Stelle "Keep under 180" und meint damit seinen
			     eigenen Anwendungsfall - ein FEST GEBAUTES Geschuetz, das der Spieler beim
			     Aufstellen ausrichtet. Eine geworfene Box kann man nicht ausrichten, und mit
			     dem geerbten Wert 90 (also ±45°) sah ein Grossteil der Umgebung schlicht
			     nichts. ⚠ Die Grenze filtert die ZIELSUCHE, nicht bloss das Zielen:
			     `findTarget` -> `canHitEntity` -> `trackTarget` verwirft ein Ziel ausserhalb
			     des Bogens komplett, das Turret bemerkt es also gar nicht.
			     Technisch unbedenklich: `AutoTurretYawLerp` klemmt NICHTS, es dreht den Kopf
			     nur auf `BaseRotation.y + Yaw`. Das einzige Restrisiko ist optisch - ob das
			     geliehene Junk-Turret-Modell eine volle Umdrehung gut aussehen laesst, sagt
			     nur ein Blick. Falls nicht, ist ein Wert um 300 (±150°) der Kompromiss.
			     PitchRange bleibt unangetastet: nach oben und unten SOLL es begrenzt sein. -->
			<property name="YawRange" value="360"/>
			<property name="TurnSpeed" value="30"/>

			<!-- Streuung. Basis fuer SpreadDegreesVertical/Horizontal (31/32); die
			     9mm-Munition liefert keine eigenen Werte, also gilt dieser. -->
			<property name="RaySpread" value="3"/>

			<!-- Schneller wach als vanilla (0.5): das Turret wird mitten in den Kampf
			     geworfen, nicht vorher aufgebaut. Eine halbe Sekunde Anlauf ist dann
			     verlorene Zeit. -->
			<property name="WakeUpTime" value="0.25"/>

			<!-- SCHUSSTON EXPLIZIT, obwohl `junkturret_fire` von junkTurretGun geerbt
			     wuerde. Erstens faellt er ohnehin pro Turretsorte anders aus, das ist der
			     Sinn der Uebung. Zweitens war das Turret im ERSTEN Spieltest (2026-08-02
			     vormittags) stumm, obwohl es nachweislich 120 Schuss verbraucht hat, und
			     mit dieser Zeile ist es hoerbar (Spieltest 2026-08-02 abends, zehn Turrets).
			     ⚠ Was davon die Stille verursacht hat, ist NICHT isoliert - geerbt war ein
			     gueltiges `junkturret_fire`, es fehlte also nichts. Unterschiede, die es
			     gewesen sein koennen: `junkturret_fire` haengt an
			     AudioSource_JunkWeaponFire.prefab (andere 3D-Abschwaechung) und deckelt bei
			     MaxVoices=5, Pistol_Fire bei 30. Wer hier aufraeumen will, aendert genau
			     eine Sache und hoert nach.
			     Der vanilla-Pfad selbst ist per IL geprueft und intakt:
			       Fire() -> ParticleEffect(…, fireSound, …) -> FireControllerUtils.SpawnParticleEffect
			       -> GameManager.SpawnParticleEffectClient -> ParticleEffect.SpawnParticleEffect
			       -> PlaySoundInClient -> Audio.Manager.Play
			     Der Ton wird dort VOR jeder Partikelaufloesung gespielt (IL_0000..IL_004e),
			     ein ungueltiges Partikel kann ihn also nicht schlucken - ein LEERES schon,
			     weil dann der ganze Block in `Fire` uebersprungen wird. -->
			<property name="FireSound" value="Pistol_Fire"/>
			<property name="ParticlesMuzzleFire" value="gunfire_pistol"/>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Machine Gun. Dauerfeuer, frisst sich schnell leer.
		     ============================================================
		     Aufbau, Tag-Pflicht und die Begruendung fuers Erben stehen beim Gun Turret oben;
		     hier nur noch, was sich unterscheidet. -->
		<entity_class name="agentTurretMG" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>
			<property name="MaxDistance" value="22"/>
			<!-- Rundumsicht, Begruendung beim Gun Turret oben. -->
			<property name="YawRange" value="360"/>
			<property name="TurnSpeed" value="26"/>
			<!-- Deutlich streuender als das Gun Turret: das ist der Preis fuers Dauerfeuer
			     und der Grund, warum das MG-Turret auf Distanz schlechter ist als das
			     Sniper-Turret, obwohl beide 7.62 verschiessen. -->
			<property name="RaySpread" value="7"/>
			<property name="WakeUpTime" value="0.25"/>
			<property name="FireSound" value="ak47_fire"/>
			<property name="ParticlesMuzzleFire" value="gunfire_MG_AK47"/>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Shotgun. Tuersteher auf kurze Distanz.
		     ============================================================ -->
		<entity_class name="agentTurretShotgun" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>
			<!-- 9 m. Die Munition begrenzt zusaetzlich: `ammoShotgunShell` setzt
			     `MaxRange base_set 10` und `DamageFalloffRange 4` - das Turret waere also
			     auch mit groesserem MaxDistance nicht weitreichender, es wuerde nur auf
			     Ziele schwenken, die es nicht mehr erreicht. -->
			<property name="MaxDistance" value="9"/>
			<!-- Weiter Schwenkbereich, weil es auf kurze Distanz einen Korridor decken soll. -->
			<!-- Rundumsicht, Begruendung beim Gun Turret oben. -->
			<property name="YawRange" value="360"/>
			<property name="TurnSpeed" value="34"/>
			<property name="RaySpread" value="4"/>
			<property name="WakeUpTime" value="0.2"/>
			<!-- ⚠ RayCount bleibt bei 1: die Schrotgarbe kommt NICHT von hier, sondern aus
			     `RoundRayCount base_set 10` in `ammoShotgunShell`. `Fire` ueberschreibt den
			     XML-Wert mit PassiveEffect 16, sobald die Munition einen setzt. Wer hier
			     zusaetzlich hochdreht, aendert nichts. -->
			<property name="FireSound" value="pump_shotgun_fire"/>
			<property name="ParticlesMuzzleFire" value="gunfire_SG_pump"/>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Sniper. Einzelschuss auf grosse Distanz.
		     ============================================================ -->
		<entity_class name="agentTurretSniper" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>
			<property name="MaxDistance" value="45"/>
			<!-- Rundumsicht, Begruendung beim Gun Turret oben. -->
			<property name="YawRange" value="360"/>
			<!-- Bewusst der langsamste Schwenk der Reihe: das Sniper-Turret ist gegen
			     anrueckende Ziele stark und gegen bereits nahe schwach. Ohne diesen Nachteil
			     waere es die dominante Wahl auf jeder Distanz.
			     ⚠ 14 -> 20 mit der Umstellung auf Rundumsicht. Solange der Bogen bei ±75°
			     lag, war der langsame Schwenk ein Nachteil INNERHALB eines kleinen Feldes;
			     seit jedes Ziel zaehlt, kann der Weg bis zu 180° betragen, und mit 14°/s
			     waeren das dreizehn Sekunden - bei 120 s Laufzeit ein Neuntel seines Lebens,
			     bevor der erste Schuss faellt. Mit 20°/s sind es neun Sekunden im
			     schlimmsten und gut vier im durchschnittlichen Fall.
			     ⚠ SEIT DER RUNDUMSICHT IST `TurnSpeed` DER WICHTIGSTE BALANCE-HEBEL der
			     Reihe: der Schwenkbereich unterscheidet die Sorten nicht mehr, die
			     Schwenkgeschwindigkeit schon. -->
			<property name="TurnSpeed" value="20"/>
			<property name="RaySpread" value="0.5"/>
			<property name="WakeUpTime" value="0.4"/>
			<!-- Einzelschuss mit Nachladepause statt Kadenz: BurstRoundCount 1 plus
			     CooldownTime gibt den charakteristischen Rhythmus. Die RoundsPerMinute am
			     Kern-Item bleibt trotzdem noetig - sie bestimmt den Abstand INNERHALB einer
			     Salve, CooldownTime den Abstand zwischen den Salven. -->
			<property name="BurstRoundCount" value="1"/>
			<property name="CooldownTime" value="1.6"/>
			<property name="FireSound" value="sniperrifle_fire"/>
			<property name="ParticlesMuzzleFire" value="gunfire_rifle_sniper"/>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Flammenwerfer. Kein Schaden aus der Kugel, sondern aus dem Buff.
		     ============================================================
		     ⚠ HIER STEHT ABSICHTLICH KEIN `FireSound` UND KEIN `ParticlesMuzzleFire`.
		     Der vanilla-Weg ist fuer eine Flamme der falsche: beide Werte haengen an EINEM
		     `new ParticleEffect(...)` am Ende von `Fire`, das PRO SCHUSS ein neues Exemplar in
		     die Welt setzt - ohne Elternteil, ohne Obergrenze, und nur dann von selbst
		     verschwindend, wenn der Effekt ein Einmaleffekt ist. `flame_hazard` ist keiner: es
		     ist der Dauerbrenner der Rohr-Hazards und laeuft endlos. Vier Schuss pro Sekunde
		     ergaben so vier ewige Flammen pro Sekunde, an fester Weltposition, und sie blieben
		     auch nach dem Abbau des Turrets stehen (Spieltest 2026-08-03).
		     Stattdessen macht `TurretFlameJet` (C#) EIN Exemplar als Kind des
		     `Muzzle`-Transforms und schaltet es mit dem Feuern an und aus. Die volle
		     Begruendung samt IL-Belegen steht dort; die Stellschrauben stehen hier. -->
		<entity_class name="agentTurretFlame" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>
			<property name="MaxDistance" value="6"/>
			<!-- Rundumsicht, Begruendung beim Gun Turret oben. -->
			<property name="YawRange" value="360"/>
			<property name="TurnSpeed" value="40"/>
			<!-- Breite Garbe: eine Flamme trifft eine Gruppe, nicht ein Ziel. -->
			<property name="RaySpread" value="9"/>
			<property name="RayCount" value="3"/>
			<property name="WakeUpTime" value="0.2"/>
			<!-- `Buff` ist eine Kommaliste (Leerzeichen werden entfernt) und geht als
			     `buffActions` in `ItemActionAttack.Hit`, wo sie auf die getroffene Entity
			     angewandt wird (IL_0dd6..IL_0e45). Die Trefferchance kommt aus PassiveEffect
			     195 mit Basis 1.0, also immer.
			     ⚠ DIE ZWEI VANILLA-BUFFS WIRKEN NUR AM SPIELER. Sie stehen hier weiterhin,
			     weil sie den Spielerfall richtig erledigen - Bildschirmeffekt, 10 HP/s,
			     Mobilitaet, und die Brandoptik ueber `buffIsOnFire`. Gegen Zombies tun sie
			     fast nichts, und genau darauf hatte sich der Entwurf verlassen; den offenen
			     Nicht-Spieler-Zweig traegt jetzt `buffAgentFlameBurn`. Die ganze Begruendung
			     mit Zeilenangaben steht im Kommentarblock dieses Buffs in buffs.xml.
			     Der Hauptschaden steckt NICHT hier, sondern im Strahlschaden von
			     `ammoAgentFlameFuel`: Buffschaden hat keinen Verursacher und wuerde dem
			     Werfer keine Erfahrungspunkte einbringen. -->
			<property name="Buff" value="buffAgentFlameBurn,buffBurningHazardPlayer,buffHazard_Slow"/>

			<!-- ==== Dauerflamme, gelesen von TurretFlameJet ==============================
			     `flame_hazard` ist genau die lange, waagerechte Flamme der Rohr-Hazards in
			     POIs (blocks.xml, `pipeFireHazardBlack2m` und Verwandte).
			     Die Drehung war erschlossen, nicht gemessen: die Hazard-Bloecke setzen das
			     Partikel an `ParticleOffset` und legen die Schadenszone von dort aus nach +X
			     (`DamageOffset="1,0,0"` mit `DamageSize="3,1,1"` beim 3-m-Rohr), also stoesst
			     das Prefab entlang seiner LOKALEN +X-Achse aus. Das Muzzle-Transform zeigt wie
			     jedes Unity-Transform nach +Z, `0,-90,0` dreht +X darauf.
			     Stand am 2026-08-03: im Spiel gesehen, die Flamme dreht sich mit dem Rohr, und
			     es ist genau eine. Ob sie dabei WAAGERECHT NACH VORNE zeigt, ist damit noch
			     nicht ausdruecklich bestaetigt - steht sie quer, ist `0,90,0` der Gegenversuch,
			     zeigt sie nach hinten, `0,180,0` zusaetzlich. Kein Rebuild noetig, nur die Zeile.
			     Der Offset ist die Laenge vor der Muendung, in Metern, im lokalen System des
			     Rohrs - z bei dieser Drehung nach VORNE.
			     ⚠ Er zaehlt ab der DUESE, nicht ab der Prefab-Wurzel. `flame_hazard` ist fuer
			     einen Block gebaut und hat seinen Brenner rund anderthalb Meter ueber seiner
			     Wurzel - genau der Versatz, mit dem die Flamme am 2026-08-03 ueber der Muendung
			     schwebte. TurretFlameJet MISST ihn beim Anlegen und rechnet ihn heraus
			     (Begruendung in `AlignEmitter`), deshalb heisst `0,0,0.1` hier wirklich "zehn
			     Zentimeter vor der Muendung". `AgentFlameJetAutoAlign="0"` schaltet die Messung
			     ab, dann gilt der Offset wieder ab der Wurzel. Der gemessene Wert steht als
			     "Duesenversatz im Prefab" im Log. -->
			<property name="AgentFlameJet" value="flame_hazard"/>
			<property name="AgentFlameJetRotation" value="0,-90,0"/>
			<property name="AgentFlameJetOffset" value="0,0,0.1"/>
			<property name="AgentFlameJetAutoAlign" value="1"/>
			<property name="AgentFlameJetScale" value="1"/>
			<!-- `flametrap_lp` ist in sounds.xml:12535 mit `Loop="true"` deklariert, wird also
			     einmal gestartet und einmal gestoppt. Start- und Endton sind dieselben, die die
			     Hazard-Bloecke benutzen. -->
			<property name="AgentFlameJetSound" value="flametrap_lp"/>
			<property name="AgentFlameJetStartSound" value="flametrap_start"/>
			<property name="AgentFlameJetStopSound" value="flametrap_end"/>
		</entity_class>

		<!-- ============================================================
		     AGENT TURRET - Schock. Crowd Control statt Schaden.
		     ============================================================
		     Das Turret, das man wirft, um Zeit zu kaufen. Der Schaden liegt unter dem der
		     anderen, aber nicht mehr weit darunter: "macht ja gar nix" war der Befund vom
		     2026-08-03, und die Ursache war dieselbe wie beim Flammenwerfer - die Wirkung
		     steckte in einem Buff, der nichts tat. Jetzt traegt vanillas `buffShocked` die
		     Kontrolle und der Strahlschaden das Gewicht. -->
		<entity_class name="agentTurretShock" extends="junkTurretGun">
			<property name="Tags" value="turret,turretRanged,deployed,noMedBuffs,agentTurret"/>
			<property name="MaxDistance" value="14"/>
			<!-- Rundumsicht, Begruendung beim Gun Turret oben. -->
			<property name="YawRange" value="360"/>
			<!-- Deutlich schneller als die anderen (32), weil dieses Turret als einziges
			     STAENDIG das Ziel wechselt: sobald ein Schock sitzt, gilt der Zombie als
			     erledigt und der naechste ist dran. Die Drehzeit ist damit der eigentliche
			     Taktgeber, nicht die Feuerrate - und vanilla wartet das Einschwenken nicht ab,
			     schiesst also waehrend der Drehung daneben. Je schneller der Kopf herumkommt,
			     desto weniger Zellen gehen ins Leere. Begruendung im Kopf von
			     Patch_TurretShockRotation. -->
			<property name="TurnSpeed" value="100"/>
			<property name="RaySpread" value="2"/>
			<property name="WakeUpTime" value="0.2"/>
			<!-- Schaltet Patch_TurretShockRotation ein: ein bereits geschockter oder gerade
			     schockimmuner Zombie gilt als erledigt, damit vanillas eigene Zielsuche auf den
			     naechstgelegenen ungeschockten weitergeht. Aus diesem einen Schalter entsteht
			     das Round Robin - das Turret haelt eine MENGE in Kontrolle statt einen
			     Einzelnen unter Dauerfeuer. -->
			<property name="AgentShockRotateTargets" value="1"/>
			<!-- Vanillas `buffShocked`, und zwar nach zwei Fehlversuchen mit eigenen Buffs.
			     Er ist der SCHOCK, nicht eine Annaeherung daran: 90 Prozent Verlangsamung mit
			     Abklingen auf 5 ueber die Buffdauer (vanilla buffs.xml ab 6763, die Gruppe
			     hinter `$shockDurationMax GTE 4`), das Partikel `p_electric_shock` am Spine,
			     der Ton `electric_fence_impact`, und `HealthChangeOT base_add -5`.
			     ⚠ ER WURDE FRUEHER AUS EINEM FALSCHEN GRUND GEMIEDEN. Die Sorge war, sein
			     Schaden haenge an fremdem Kontext (`ItemHasTags tags="stunBaton"`,
			     `perkIntelMaster5`, `_droneStunDamage`). Nachgelesen: die unbedingte Zeile
			     "Not a Stun Baton" setzt `$buffShockedDamage` zuerst auf -5, und alle drei
			     Erhoehungen haengen an Bedingungen, die hier nie zutreffen - unser Kern-Item
			     traegt kein `stunBaton`, und die beiden CVars sitzen an der GESCHOCKTEN Entity,
			     also am Zombie. Der Schaden ist damit fest -5. Die Vorsicht hat das Turret
			     seine ganze Wirkung gekostet.
			     Selbstbegrenzung inklusive: laeuft der Buff aus, setzt vanilla
			     `buffShockImmune` (5 s, `BuffResistance base_set 2`, auf 0..1 geklemmt = volle
			     Immunitaet). `ItemActionAttack.Hit` uebergibt `_netSync = true` (IL_0e4c),
			     also greift die Immunitaetspruefung in `AddBuff` (IL_004C) wirklich. Ergibt
			     4 s Schock, 5 s Ruhe je Ziel - kein Dauer-Stunlock, ohne eigenes Zutun.
			     `buffHazard_Slow` ist hier entfallen: `buffShocked` verlangsamt ungegattert,
			     also auch den Spieler, der in den eigenen Strahl laeuft. -->
			<property name="Buff" value="buffShocked"/>
			<!-- ⚠ NICHT `drone_attack_stun`. Der Name klingt nach Elektrizitaet, ist aber eine
			     SPRACHAUSGABE: `AudioSource_VO_Drone.prefab` mit Clips aus `Sounds/VO/Drone/`
			     (vanilla sounds.xml:18639). Bei 120 Schuss/Minute hat das Turret damit
			     zweimal pro Sekunde eine Drohnen-Sprachzeile gesprochen - im Spielbericht vom
			     2026-08-03 "das redet die ganze Zeit". `stunbaton_hit4` ist ein einzelner
			     Elektro-Impuls an `AudioSource_Impact_Large`, und er liegt tonal unter dem
			     `electric_fence_impact`, das `buffShocked` am Ziel spielt: Schuss und
			     Einschlag bleiben unterscheidbar. -->
			<property name="FireSound" value="stunbaton_hit4"/>
			<!-- Es gibt in vanilla KEIN Elektro-Muendungsfeuer: die vollstaendige Liste der in den
			     Konfigurationsdateien referenzierten Partikelnamen enthaelt nur Waffen-, Feuer-,
			     Baum- und Fahrzeugeffekte. Deshalb der neutrale Maschinen-Flash des Junk Turret.
			     ⚠ NICHT auf leer setzen: in `Fire` liegt der GESAMTE Block aus Partikel UND
			     Schusston hinter `if (!IsNullOrEmpty(muzzleFireParticle))` (IL_0503..IL_050e).
			     Ein leerer Partikelname macht das Turret also auch stumm. -->
			<property name="ParticlesMuzzleFire" value="gunfire_junkturret"/>
		</entity_class>
	</append>

</configs>
